# Font Configuration
font_family      family='JetBrainsMono Nerd Font Mono' postscript_name=JetBrainsMonoNFM-Regular
bold_font        auto
italic_font      auto
bold_italic_font auto
font_size 15.0

# Window Configuration
window_padding_width 12
background_opacity 0.95
background_blur 32
hide_window_decorations titlebar-only
window_border_width 1
draw_minimal_borders yes

# Cursor Configuration
cursor_shape block
cursor_blink_interval 0
cursor_beam_thickness 2

# Scrollback
scrollback_lines 50000

# Terminal features
copy_on_select yes
strip_trailing_spaces smart
detect_urls yes

# Key bindings for common actions
map ctrl+shift+n new_window
# map ctrl+t new_tab
map ctrl+plus change_font_size all +1.0
map ctrl+minus change_font_size all -1.0
map ctrl+0 change_font_size all 0

## jump to end of line:
map super+right send_text all \x05

## jump to start of line:
map super+left send_text all \x01

## jump right to end of word:
map alt+right send_text all \x1b\x66

## jump left to beginning of word:
map alt+left send_text all \x1b\x62

## delete line from cursor position to start of line:
map super+backspace send_text all \x15

## undo:
map super+z send_text all \x1f

action_alias launch_tab launch --cwd=current --type=tab

# Tab configuration
tab_bar_style powerline
tab_bar_align left
tab_bar_edge  bottom

# Shell integration
shell_integration enabled

# Dank color generation
# include dank-tabs.conf
# include dank-theme.conf

include current-theme.conf
